# Cutbackito uses the `claude` CLI (Claude Code) to talk to Claude — your
# Pro/Max subscription covers it, no API key needed.
#
# Prereqs on the host:
#   1. Install Claude Code:  https://claude.com/claude-code
#   2. Run: claude login
#   3. Make sure `claude --version` works for the user running this app

# Optional: pin a specific model (defaults to whatever Claude Code picks)
# CLAUDE_MODEL=claude-sonnet-4-6
# CLAUDE_MODEL=claude-opus-4-7

# How long to wait for `claude -p` to return (seconds)
CLAUDE_TIMEOUT_SECONDS=300

# Whisper transcription
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Where to store projects + exports
WORKSPACE_DIR=./workspace

# Max size per uploaded file
MAX_UPLOAD_MB=2048
